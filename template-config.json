{
  "buckets": {},
  "services": {
    "3f0595fe-e446-4387-b793-6d35f0346902": {
      "icon": "https://raw.githubusercontent.com/perminder-klair/subwave/8f4c74dafa5d730bd3ca3763106e0c7462c38b5e/app/assets/icon.png",
      "name": "SUBWAVE",
      "build": {
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/api/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/subwave-railway",
        "rootDirectory": "/"
      },
      "variables": {
        "PORT": {
          "defaultValue": "80",
          "description": "Port the built-in Caddy listens on - leave as is",
          "isOptional": false
        },
        "ADMIN_USER": {
          "defaultValue": "admin",
          "description": "Username for /admin",
          "isOptional": false
        },
        "ADMIN_PASS": {
          "defaultValue": "${{secret(24)}}",
          "description": "Password for /admin, generated at deploy",
          "isOptional": false
        },
        "SITE_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL, used for share cards, canonical links and the sitemap",
          "isOptional": false
        },
        "NAVIDROME_URL": {
          "defaultValue": "http://${{Navidrome.RAILWAY_PRIVATE_DOMAIN}}:4533",
          "description": "Music library (Subsonic API) over the private network",
          "isOptional": false
        },
        "NAVIDROME_USER": {
          "defaultValue": "admin",
          "description": "Navidrome user the DJ reads the library as",
          "isOptional": false
        },
        "NAVIDROME_PASS": {
          "defaultValue": "${{Navidrome.ND_DEVAUTOCREATEADMINPASSWORD}}",
          "description": "Navidrome password - taken from the Navidrome service",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {
        "3f0595fe-e446-4387-b793-6d35f0346902": {
          "mountPath": "/var/sub-wave"
        }
      }
    },
    "316d870c-389e-44cd-8bbd-8060766dfae5": {
      "icon": "https://raw.githubusercontent.com/navidrome/navidrome/master/resources/logo-192x192.png",
      "name": "Navidrome",
      "build": {
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/ping",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/nomideusz/navidrome-railway",
        "rootDirectory": "/"
      },
      "variables": {
        "PORT": {
          "defaultValue": "4533",
          "description": "Port Navidrome listens on - leave as is",
          "isOptional": false
        },
        "ND_ADDRESS": {
          "defaultValue": "[::]",
          "description": "Listen on IPv4 and IPv6 so the station reaches it over the private network",
          "isOptional": false
        },
        "ND_DEVAUTOCREATEADMINPASSWORD": {
          "defaultValue": "${{secret(24)}}",
          "description": "Password of the Navidrome 'admin' user, created on first boot",
          "isOptional": false
        },
        "FILEBROWSER_PASSWORD": {
          "defaultValue": "${{secret(24)}}",
          "description": "Password for the music upload panel (user: admin), set on first boot",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:4533": {
            "port": 4533
          },
          "<hasDomain>:8080": {
            "port": 8080
          }
        }
      },
      "volumeMounts": {
        "316d870c-389e-44cd-8bbd-8060766dfae5": {
          "mountPath": "/data"
        }
      }
    }
  }
}
